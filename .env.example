# Shopify Storefront API
#
# Get these from Shopify Admin → Settings → Apps and sales channels →
# Develop apps → [Nooni Storefront app] → API credentials.
#
# Both are NEXT_PUBLIC_* because the Storefront API is designed to be
# called directly from the client. They're embedded in the JS bundle
# at build time. The token is rate-limited per token (not per origin)
# and can be rotated in Shopify without a code change.
#
# Set the real values in:
#   - .env.local        (local dev — gitignored, never commit)
#   - Vercel env vars   (Preview + Production environments)

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=nooni-2711.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
